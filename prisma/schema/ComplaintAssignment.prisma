model ComplaintAssignment {
  id           String    @id @default(uuid())
  complaintId  String
  assignedToId String
  assignedById String
  note         String?
  assignedAt   DateTime  @default(now())
  completedAt  DateTime?

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignedTo User @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignedBy User @relation("ComplaintAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([complaintId])
  @@index([assignedToId])
  @@index([assignedById])
  @@map("complaint_assignments")
}
