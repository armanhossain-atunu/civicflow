model ComplaintAssignment {
    id String @id @default(uuid())

    complaintId String
    assigneeId  String

    assignedAt DateTime @default(now())
    updatedAt  DateTime @updatedAt

    complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    assignee    User      @relation(fields: [assigneeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([complaintId])
    @@index([assigneeId])
    @@map("complaint_assignments")
}
