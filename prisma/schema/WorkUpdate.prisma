model WorkUpdate {
  id          String   @id @default(uuid())

  complaintId String
  updatedById String

  title       String
  description String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updatedBy   User      @relation(fields: [updatedById], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([complaintId])
  @@index([updatedById])
}