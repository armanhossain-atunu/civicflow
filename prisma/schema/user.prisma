model User {
  id                 String       @id @default(uuid())
  name               String
  email              String
  password           String?
  googleId           String?      @unique
  authProvider       AuthProvider @default(CREDENTIAL)
  emailVerified      Boolean      @default(false)
  role               Role         @default(CITIZEN)
  status             UserStatus   @default(ACTIVE)
  needPasswordChange Boolean      @default(false)
  isDeleted          Boolean      @default(false)
  imageUrl           String       @default("")
  imagePublicId      String       @default("")
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  citizen            Citizen?
  // payments        
  payments           Payment[]

  complaints         Complaint[]
  feedbacks          Feedback[]
  workUpdates        WorkUpdate[]
  assignedComplaints ComplaintAssignment[]    @relation("ComplaintAssignedTo")
  createdAssignments ComplaintAssignment[]    @relation("ComplaintAssignedBy")
  statusChanges      ComplaintStatusHistory[]

  @@unique([email])
  @@index([emailVerified])
  @@map("users")
}
