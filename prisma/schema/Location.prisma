model Location {
  id          String   @id @default(uuid())

  address     String
  latitude    Decimal?
  longitude   Decimal?

  city        String?
  area        String?
  postalCode  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaints  Complaint[]

  @@index([city])
  @@index([area])

  @@map("locations")
}