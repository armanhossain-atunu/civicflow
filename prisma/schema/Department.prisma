model Department {
  id          String   @id @default(uuid())

  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaints  Complaint[]

  @@index([isActive], name: "idx_department_isActive")

  @@map("departments")
}