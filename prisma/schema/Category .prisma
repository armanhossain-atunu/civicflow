model Category {
  id          String   @id @default(uuid())

  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  status     categoryStatus @default(FREE)
   price       Decimal?       @db.Decimal(10, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  complaints  Complaint[]

  @@index([isActive])
  @@index([status])
  @@map("Category")
}