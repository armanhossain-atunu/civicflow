model Complaint {
  id            String            @id @default(uuid())
  trackingId    String            @unique

  title         String
  description   String

  status        ComplaintStatus   @default(SUBMITTED)
  priority      ComplaintPriority @default(MEDIUM)

  paymentStatus PaymentStatus     @default(NOT_REQUIRED)
  paymentAmount Decimal?          @db.Decimal(10, 2)

  citizenId     String
  categoryId    String

  // Snapshot fields
  categoryName  String
  department    String
  location      String

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // relations
  citizen       User      @relation(fields: [citizenId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments   ComplaintAssignment[]
  attachments   ComplaintAttachment[]
  statusHistory ComplaintStatusHistory[]
  workUpdates   WorkUpdate[]
  feedback      Feedback[]

  payment       Payment?

  @@index([citizenId], name: "idx_complaint_citizenId")
  @@index([categoryName], name: "idx_complaint_categoryName")
  @@index([status])
  @@index([department])
  @@index([location])
  @@index([paymentStatus])

  @@map("complaints")
}