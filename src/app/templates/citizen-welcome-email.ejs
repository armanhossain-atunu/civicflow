<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to CivicFlow</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
        box-sizing: border-box;
      }

      .container {
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
      }

      .header {
        padding: 30px 24px;
        text-align: center;
        background-color: #2563eb;
        color: #ffffff;
      }

      .brand {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        letter-spacing: 0.5px;
      }

      .header-text {
        margin: 8px 0 0;
        font-size: 14px;
        color: #dbeafe;
      }

      .content {
        padding: 36px 30px;
      }

      .title {
        margin: 0 0 18px;
        font-size: 24px;
        line-height: 1.3;
        color: #111827;
      }

      .text {
        margin: 0 0 16px;
        font-size: 15px;
        line-height: 1.7;
        color: #4b5563;
      }

      .name {
        color: #2563eb;
        font-weight: 600;
      }

      .footer {
        padding: 22px 30px;
        text-align: center;
        background-color: #f9fafb;
        border-top: 1px solid #e5e7eb;
      }

      .footer p {
        margin: 0;
        font-size: 12px;
        line-height: 1.6;
        color: #9ca3af;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .header {
          padding: 25px 20px;
        }

        .content {
          padding: 28px 20px;
        }

        .footer {
          padding: 20px;
        }

        .brand {
          font-size: 23px;
        }

        .title {
          font-size: 21px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->
        <div class="header">
          <h1 class="brand">CivicFlow</h1>

          <p class="header-text">Connecting Citizens with Better Services</p>
        </div>

        <!-- Content -->
        <div class="content">
          <h2 class="title">
            Welcome to CivicFlow, <span class="name"><%= name %></span>!
          </h2>

          <p class="text">
            Thank you for joining <strong>CivicFlow</strong>. Your account has
            been created successfully.
          </p>

          <p class="text">
            You can now submit complaints and service requests, track their
            progress, receive status updates, and stay connected with your local
            public services—all in one place.
          </p>

          <p class="text">
            We're happy to have you with us. Together, let's build a more
            connected, transparent, and citizen-friendly community.
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>
            &copy; <%= new Date().getFullYear() %> CivicFlow. All rights
            reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
