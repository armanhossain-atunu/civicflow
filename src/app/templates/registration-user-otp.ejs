<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verification - CivicFlow</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
        box-sizing: border-box;
      }

      .container {
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
      }

      /* Header */
      .header {
        padding: 30px 24px;
        text-align: center;
        background-color: #2563eb;
        color: #ffffff;
      }

      .brand {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        letter-spacing: 0.5px;
      }

      .header-text {
        margin: 8px 0 0;
        font-size: 14px;
        color: #dbeafe;
      }

      /* Content */
      .content {
        padding: 36px 30px;
      }

      .title {
        margin: 0 0 18px;
        font-size: 24px;
        line-height: 1.3;
        color: #111827;
      }

      .text {
        margin: 0 0 16px;
        font-size: 15px;
        line-height: 1.7;
        color: #4b5563;
      }

      .email {
        font-weight: 600;
        color: #2563eb;
      }

      /* OTP */
      .otp-wrapper {
        margin: 30px 0;
        text-align: center;
      }

      .otp-label {
        margin-bottom: 12px;
        font-size: 12px;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 1.5px;
      }

      .otp {
        display: inline-block;
        padding: 16px 28px;
        background-color: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        color: #1d4ed8;
        font-size: 32px;
        font-weight: 700;
        letter-spacing: 8px;
        line-height: 1;
      }

      /* Expiration */
      .expiry {
        margin: 0;
        padding: 14px 16px;
        background-color: #fefce8;
        border-left: 4px solid #eab308;
        border-radius: 6px;
        font-size: 13px;
        line-height: 1.6;
        color: #713f12;
      }

      /* Security */
      .security {
        margin: 22px 0 0;
        font-size: 13px;
        line-height: 1.7;
        color: #6b7280;
      }

      /* Footer */
      .footer {
        padding: 22px 30px;
        text-align: center;
        background-color: #f9fafb;
        border-top: 1px solid #e5e7eb;
      }

      .footer p {
        margin: 0;
        font-size: 12px;
        line-height: 1.6;
        color: #9ca3af;
      }

      /* Mobile */
      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .header {
          padding: 25px 20px;
        }

        .content {
          padding: 28px 20px;
        }

        .footer {
          padding: 20px;
        }

        .brand {
          font-size: 23px;
        }

        .title {
          font-size: 21px;
        }

        .otp {
          padding: 14px 20px;
          font-size: 26px;
          letter-spacing: 6px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
    
      <div class="container">
        <!-- Header -->
        <div class="header">
          <h1 class="brand">CivicFlow</h1>

          <p class="header-text">Secure Email Verification</p>
        </div>

        <!-- Main Content -->
        <div class="content">
          <h2 class="title">Verify Your Email Address</h2>

          <p class="text">Hello <strong><%= name %></strong>,</p>

          <p class="text">
            We received a request to verify the email address
            <span class="email"><%= email %></span>.
          </p>

          <p class="text">
            Please use the verification code below to complete your email
            verification.
          </p>

          <!-- OTP -->
          <div class="otp-wrapper">
            <div class="otp-label">Your Verification Code</div>

            <div class="otp"><%= otp %></div>
          </div>

          <!-- Expiration Notice -->
          <p class="expiry">
            <strong>Important:</strong>
            This verification code will expire in
            <strong><%= expirationMinutes %> minutes</strong>.
          </p>

          <!-- Security Notice -->
          <p class="security">
            If you did not request this verification, you can safely ignore this
            email. For your security, never share this verification code with
            anyone.
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>
            &copy; <%= new Date().getFullYear() %> CivicFlow. All rights
            reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
